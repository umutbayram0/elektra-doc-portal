{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elektraweb.dev/schemas/guides-content.schema.json",
  "title": "GuidesContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocNode"
      }
    }
  },
  "required": ["title", "description", "cards"],
  "additionalProperties": false,
  "$defs": {
    "DocNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "example": {
          "type": "string"
        },
        "exampleLang": {
          "type": "string"
        },
        "exampleFilename": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["tip", "warning", "note"]
              },
              "text": {
                "type": "string"
              }
            },
            "required": ["type", "text"],
            "additionalProperties": false
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "default": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["name", "type", "description"],
            "additionalProperties": false
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["label", "path"],
            "additionalProperties": false
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocNode"
          }
        }
      },
      "required": ["id", "title", "description"],
      "additionalProperties": false
    }
  }
}
